# Local development only. Never commit real secrets.
JIBIK_DEBUG=true
JIBIK_SECRET_KEY=replace-me-with-a-random-secret
JIBIK_ALLOWED_HOSTS=localhost,127.0.0.1
# Production additionally requires PostgreSQL:
# JIBIK_DB_HOST=db.internal
# JIBIK_DB_NAME=jibik
# JIBIK_DB_USER=jibik
# JIBIK_DB_PASSWORD=...
# JIBIK_DB_SSLMODE=require
# Jibik AIaaS, server-side only. Use your own provisioned Arvan endpoint.
ARVAN_AI_ENABLED=false
ARVAN_AI_BASE_URL=
ARVAN_AI_API_KEY=
ARVAN_AI_MODEL=
ARVAN_AI_TIMEOUT_SECONDS=10
ARVAN_AI_MAX_RETRIES=1
ARVAN_AI_MAX_TOKENS=700
ARVAN_AI_USER_DAILY_LIMIT=10
ARVAN_AI_GLOBAL_DAILY_LIMIT=200
