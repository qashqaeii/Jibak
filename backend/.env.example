# Local development only. Never commit real secrets.
JIBIK_DEBUG=true
JIBIK_SECRET_KEY=replace-me-with-a-random-secret
JIBIK_ALLOWED_HOSTS=localhost,127.0.0.1
# Production additionally requires PostgreSQL:
# JIBIK_DB_HOST=db.internal
# JIBIK_DB_NAME=jibik
# JIBIK_DB_USER=jibik
# JIBIK_DB_PASSWORD=...
# JIBIK_DB_SSLMODE=require
